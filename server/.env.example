# Copy to server/.env (git-ignored) and fill in your values.
# Find the endpoint and key on your deployment's page in Azure AI Foundry.
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-key>
# The deployment name you chose, which can differ from the model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Optional. Set this to use the classic versioned Azure API. Leave it out to use Azure's v1 API.
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Optional. minimal, low, medium, or high. Lower is faster. Defaults to low.
# AZURE_OPENAI_REASONING_EFFORT=low
